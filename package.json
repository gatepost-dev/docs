{
  "name": "gatepost-docs",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "sdk": "run-s sdk:js sdk:js:build",
    "sdk:js": "pnpm --dir js install --frozen-lockfile",
    "sdk:js:build": "pnpm --dir js --filter @gatepost/core --filter @gatepost/client run build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "run-s check:source check:site check:policy",
    "check:source": "run-s format:check lint typecheck test",
    "check:site": "run-s build test:site test:browser",
    "check:policy": "run-s tells prose context:check licences reuse:check workflows:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run --project unit --coverage",
    "test:site": "vitest run --project site",
    "tells": "python3 spec/scripts/check-tells",
    "prose": "node scripts/check-prose.ts",
    "context:check": "cmp CONTEXT.md spec/CONTEXT.md",
    "licences": "node scripts/check-licences.ts",
    "reuse:check": "uvx --with charset-normalizer==3.5.2 reuse@6.2.0 lint",
    "workflows:check": "uvx zizmor@1.30.1 --offline .github/workflows",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@fontsource/overpass": "^5.3.0",
    "@gatepost/client": "link:js/packages/client",
    "@gatepost/core": "link:js/packages/core",
    "astro": "^7.3.5",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@gatepost/mock-server": "link:js/packages/mock-server",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
